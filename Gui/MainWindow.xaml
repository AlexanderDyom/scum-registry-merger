<Window x:Class="RegistryMerger.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RegistryMerger.Gui"
        Style="{StaticResource AppWindow}" Title="SCUM Registry Merger"
        Width="780" Height="540" MinWidth="620" MinHeight="400" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- install line: what is scanned, key state, refresh, settings -->
    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource IconBtn}" Click="Refresh_Click" ToolTip="{l:T Refresh}" AutomationProperties.Name="{l:T Refresh}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
          </Button>
          <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0" Click="Settings_Click" ToolTip="{l:T Settings}" AutomationProperties.Name="{l:T Settings}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="KindIcon" Style="{StaticResource Icon}" Foreground="{StaticResource Text2}" Margin="0,0,8,0"/>
          <TextBlock x:Name="KindText" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="PathText" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
          <Border x:Name="KeyBadge" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="KeyBadgeIcon" Style="{StaticResource Icon}" FontSize="11" Text="&#xE8D7;" Margin="0,0,4,0"/>
              <TextBlock x:Name="KeyBadgeText" FontSize="11"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- status line -->
    <Border Grid.Row="1" x:Name="Banner" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="BannerButton" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="12,0,0,0" Click="BannerButton_Click"/>
        <TextBlock x:Name="BannerIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="BannerTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="BannerText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- column heads -->
    <Grid Grid.Row="2" Margin="16,8,16,6" TextElement.Foreground="{StaticResource Text2}" TextElement.FontSize="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="170"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="{l:T ColMod}"/>
      <TextBlock Grid.Column="2" Text="{l:T ColNew}"/>
      <TextBlock Grid.Column="3" Text="{l:T ColRegistry}"/>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ModList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type l:ModRow}">
                <Border Background="{Binding RowBrush}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,9" ToolTip="{Binding Tip}" ToolTipService.ShowDuration="20000">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding StateBrush}" FontSize="17"/>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <Border Background="{StaticResource WarnBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                          <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource Warn}"/>
                        </Border>
                        <Border Background="{StaticResource OrangeBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding VersionBadgeVisibility}">
                          <TextBlock Text="{Binding VersionBadge}" FontSize="11" Foreground="{StaticResource Orange}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" Foreground="{Binding CountBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="28" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
          <TextBlock Text="{l:T EmptyTitle}" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4"/>
          <TextBlock x:Name="EmptyText" Style="{StaticResource Small}" TextAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel Grid.Row="4" Margin="16,7">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="UpdateLink" Style="{StaticResource Link}" Margin="0,0,10,0" Visibility="Collapsed" Click="Settings_Click"/>
        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <TextBlock x:Name="FooterText" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
