<Window x:Class="RegistryMerger.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RegistryMerger.Gui"
        Style="{StaticResource AppWindow}" Title="{l:T Settings}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20,6,20,18">
    <!-- game -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="{l:T Game}"/>
        <WrapPanel>
          <RadioButton x:Name="ClientChip" Style="{StaticResource Chip}" GroupName="kind" Checked="Kind_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Client}" FontSize="12"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="ServerChip" Style="{StaticResource Chip}" GroupName="kind" Checked="Kind_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Server}" FontSize="12"/></StackPanel>
          </RadioButton>
        </WrapPanel>
        <DockPanel Margin="0,2,0,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="6,0,0,0" Click="Browse_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="{l:T Browse}"/></StackPanel>
          </Button>
          <TextBox x:Name="PathBox" Style="{StaticResource Field}" TextChanged="PathBox_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="PathStatus" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- key -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="{l:T AesKey}"/>
        <DockPanel>
          <Button x:Name="CheckKeyButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="6,0,0,0" Content="{l:T CheckKey}" Click="CheckKey_Click"/>
          <PasswordBox x:Name="KeyBox" Style="{StaticResource KeyField}" PasswordChanged="KeyBox_PasswordChanged"/>
        </DockPanel>
        <TextBlock x:Name="KeyError" FontSize="12" Foreground="{StaticResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="KeyHint" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource Small}" Text="{l:T RefInfo}" Margin="0,14,0,0" LineHeight="18"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="MakeRefButton" Style="{StaticResource Btn}" Content="{l:T MakeReference}" IsEnabled="False" Click="MakeRef_Click"
                  ToolTip="{l:T RefNeedsKey}" ToolTipService.ShowOnDisabled="True"/>
          <TextBlock x:Name="RefStatus" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="330"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- language -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="{l:T Language}"/>
        <WrapPanel x:Name="LangPanel"/>
        <TextBlock x:Name="LangNote" Style="{StaticResource Small}" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- version and updates -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="{l:T VersionUpdates}"/>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="NotesButton" Style="{StaticResource Btn}" Content="{l:T WhatsNew}" Margin="0,0,6,0" Click="Notes_Click"/>
            <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Content="{l:T UpdateNow}" Click="Update_Click"/>
            <Button x:Name="CheckButton" Style="{StaticResource Btn}" Content="{l:T CheckNow}" Click="Check_Click"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="VersionLine"/>
            <TextBlock x:Name="UpdateLine" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
        <CheckBox x:Name="AutoCheck" Style="{StaticResource Toggle}" Margin="0,12,0,0">
          <TextBlock Text="{l:T AutoCheck}" FontSize="12"/>
        </CheckBox>
      </StackPanel>
    </Border>

    <!-- remove the shared registry -->
    <DockPanel Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" x:Name="DeleteButton" Style="{StaticResource DangerBtn}" Content="{l:T DeleteRegistry}" Click="Delete_Click"/>
      <TextBlock x:Name="DeleteText" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Style="{StaticResource Btn}" Content="{l:T Cancel}" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="{l:T Save}" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
